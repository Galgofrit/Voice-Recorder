<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recording_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/list_card_margin_horizontal"
    android:layout_marginVertical="@dimen/list_card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/list_card_corner"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/normal_margin"
        android:paddingTop="19dp"
        android:paddingEnd="@dimen/normal_margin"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/recording_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/activity_margin"
            android:maxLines="2"
            android:paddingEnd="@dimen/activity_margin"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/play_pause_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Jun 1 at 14:50" />

        <TextView
            android:id="@+id/recording_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.68"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/activity_margin"
            android:layout_marginTop="@dimen/tiny_margin"
            android:maxLines="1"
            android:paddingEnd="@dimen/activity_margin"
            android:textSize="@dimen/smaller_text_size"
            app:layout_constraintEnd_toStartOf="@+id/recording_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recording_title"
            tools:text="28 March, 20:20" />

        <TextView
            android:id="@+id/recording_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.68"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/smaller_text_size"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause_button"
            app:layout_constraintEnd_toStartOf="@+id/play_pause_button"
            app:layout_constraintTop_toTopOf="@+id/play_pause_button"
            tools:text="3 MB" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_pause_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="-4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/playpause"
            android:focusable="true"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_play_vector"
            app:layout_constraintBottom_toBottomOf="@+id/recording_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recording_title" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/info_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="recording_date,play_pause_button" />

        <org.fossify.commons.views.MySeekBar
            android:id="@+id/recording_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:paddingStart="@dimen/activity_margin"
            android:max="0"
            app:layout_constraintEnd_toStartOf="@+id/recording_duration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/info_barrier" />

        <TextView
            android:id="@+id/recording_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.68"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/smaller_text_size"
            app:layout_constraintBottom_toBottomOf="@+id/recording_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recording_seekbar"
            tools:text="-00:05" />

        <TextView
            android:id="@+id/recording_transcript_snippet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="@dimen/tiny_margin"
            android:textSize="@dimen/smaller_text_size"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recording_seekbar"
            tools:text="…the quick brown fox jumps over the lazy dog…"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
